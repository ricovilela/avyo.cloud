{
  "name": "@avyo/types",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "tsc --noEmit -p tsconfig.test.json && tsc -p tsconfig.json && node --test \"test/**/*.test.mjs\""
  },
  "devDependencies": {
    "@avyo/config-eslint": "workspace:*",
    "@avyo/config-tsconfig": "workspace:*",
    "eslint": "^9.15.0",
    "typescript": ">=5.6 <6"
  }
}
