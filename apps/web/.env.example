# ---------------------------------------------------------------------------
# @avyo/web — public environment variables (example)
#
# Copy this file to `.env` and replace the placeholder values.
# This file is versioned; real `.env` files are git-ignored. Only public
# (NEXT_PUBLIC_*) values belong here, and they must be illustrative
# placeholders — never a real API URL or a real captcha site key.
# ---------------------------------------------------------------------------

# Base URL of the Avyo API consumed by the web client (src/lib API client).
# Must be an absolute HTTP or HTTPS URL.
NEXT_PUBLIC_API_URL=https://api.example.com

# Public captcha site key used by the browser to render the captcha widget.
# Illustrative placeholder — replace with your provider's real site key.
NEXT_PUBLIC_CAPTCHA_SITE_KEY=example-captcha-site-key-000000
