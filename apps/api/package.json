{
  "name": "@avyo/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "jest"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@avyo/types": "workspace:*",
    "@nestjs/common": ">=11 <12",
    "@nestjs/core": ">=11 <12",
    "@nestjs/platform-express": ">=11 <12",
    "@prisma/client": ">=6 <7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@avyo/config-eslint": "workspace:*",
    "@avyo/config-tsconfig": "workspace:*",
    "@nestjs/cli": ">=11 <12",
    "@nestjs/schematics": ">=11 <12",
    "@nestjs/testing": ">=11 <12",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.1",
    "eslint": "^9.15.0",
    "jest": "^29.7.0",
    "prisma": ">=6 <7",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": ">=5.6 <6"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": ["<rootDir>/src"],
    "testRegex": ".*\\.spec\\.ts$",
    "moduleFileExtensions": ["ts", "js", "json"]
  }
}
