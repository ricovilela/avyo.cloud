{
  "name": "@avyo/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "jest"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@avyo/types": "workspace:*",
    "@nestjs/common": ">=11 <12",
    "@nestjs/core": ">=11 <12",
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": ">=11 <12",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": ">=6 <7",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@avyo/config-eslint": "workspace:*",
    "@avyo/config-tsconfig": "workspace:*",
    "@nestjs/cli": ">=11 <12",
    "@nestjs/schematics": ">=11 <12",
    "@nestjs/testing": ">=11 <12",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.15.0",
    "fast-check": "^4.9.0",
    "jest": "^29.7.0",
    "prisma": ">=6 <7",
    "supertest": "^7.2.2",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": ">=5.6 <6"
  },
  "jest": {
    "testEnvironment": "node",
    "maxWorkers": 1,
    "roots": [
      "<rootDir>/src",
      "<rootDir>/prisma"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "moduleFileExtensions": [
      "ts",
      "js",
      "json"
    ],
    "transform": {
      "^.+\\.[tj]s$": [
        "ts-jest",
        {
          "tsconfig": {
            "allowJs": true,
            "isolatedModules": true
          }
        }
      ]
    },
    "transformIgnorePatterns": [
      "/node_modules/\\.pnpm/(?!(@nestjs\\+jwt|@nestjs\\+passport))"
    ],
    "moduleNameMapper": {
      "^@avyo/types$": "<rootDir>/../../packages/types/src/index.ts"
    }
  }
}
