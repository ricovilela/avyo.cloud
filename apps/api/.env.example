# ---------------------------------------------------------------------------
# @avyo/api — environment variables (example)
#
# Copy this file to `.env` and replace the placeholder values.
# This file is versioned; real `.env` files are git-ignored. Do NOT commit
# real secrets, credentials, or connection strings here — only illustrative
# placeholders that make the required configuration discoverable.
# ---------------------------------------------------------------------------

# Database
# PostgreSQL connection string read by Prisma (prisma/schema.prisma -> env("DATABASE_URL")).
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://user:password@localhost:5432/avyo_dev

# Authentication — access token (JWT, HS256)
# JWT_SECRET: signing secret for access tokens. Use a long, random string in real envs.
# JWT_EXPIRES_IN: access token lifetime (e.g. 15m, 1h, or seconds like 900).
JWT_SECRET=replace-with-a-long-random-access-token-secret
JWT_EXPIRES_IN=15m

# Authentication — refresh token
# REFRESH_SECRET: signing secret for refresh tokens. Use a distinct long, random string.
# REFRESH_EXPIRES_IN: refresh token lifetime (e.g. 7d, 30d).
REFRESH_SECRET=replace-with-a-long-random-refresh-token-secret
REFRESH_EXPIRES_IN=7d

# HTTP server
# Port the NestJS API listens on (src/main.ts).
PORT=3000

# Captcha (provider deferred — see mvp-project.md §11.4)
# Placeholder shape for the captcha provider secret used for server-side verification.
# The concrete provider (hCaptcha / reCAPTCHA / Turnstile) is chosen in a later spec.
CAPTCHA_SECRET_KEY=replace-with-your-captcha-provider-secret-key

# Mail (provider deferred — see mvp-project.md §11.4)
# Placeholder shape for transactional email configuration. The concrete provider
# (SMTP / Resend / SES) is chosen in a later spec.
MAIL_FROM=no-reply@example.com
MAIL_HOST=smtp.example.com
